{
  "name": "ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt --write src package.json svelte.config.js tsconfig.json vite.config.ts vitest.setup.ts .oxlintrc.json",
    "fmt:check": "oxfmt --check src package.json svelte.config.js tsconfig.json vite.config.ts vitest.setup.ts .oxlintrc.json",
    "test:unit": "vitest run",
    "test": "npm run test:unit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.911.0",
    "@aws-sdk/client-elasticache": "3.1029.0",
    "@aws-sdk/client-lambda": "3.911.0",
    "@aws-sdk/client-s3": "3.911.0",
    "@aws-sdk/credential-providers": "3.911.0",
    "@bufbuild/protobuf": "1.10.0",
    "@connectrpc/connect": "1.6.1",
    "@connectrpc/connect-web": "1.6.1",
    "bits-ui": "2.17.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-svelte": "1.0.1",
    "svelte-sonner": "1.1.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.57.0",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.2.8",
    "@vitest/coverage-v8": "4.1.3",
    "jsdom": "27.0.0",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "svelte": "5.55.2",
    "svelte-check": "4.4.6",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.7",
    "vitest": "4.1.3"
  }
}
