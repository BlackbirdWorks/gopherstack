  "type": "module",
  "scripts": {
    "smoke": "node azure_smoke.mjs",
    "aws-smoke": "node aws_smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1150.0",
    "@aws-sdk/client-dynamodb": "3.1150.0",
    "@aws-sdk/client-dynamodb-streams": "3.1150.0",
    "@aws-sdk/client-eventbridge": "3.1150.0",
    "@aws-sdk/client-iam": "3.1150.0",
    "@aws-sdk/client-kms": "3.1150.0",
    "@aws-sdk/client-lambda": "3.1150.0",
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/client-secrets-manager": "3.1150.0",
    "@aws-sdk/client-sfn": "3.1150.0",
    "@aws-sdk/client-sns": "3.1150.0",
    "@aws-sdk/client-sqs": "3.1150.0",
    "@aws-sdk/client-sts": "3.1150.0",
    "@aws-sdk/lib-dynamodb": "3.1150.0",
    "@aws-sdk/lib-storage": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@azure/cosmos": "4.10.1",
    "@azure/data-tables": "13.3.2",
    "@azure/storage-blob": "12.34.0",
    "@azure/storage-queue": "12.32.0"
  }
